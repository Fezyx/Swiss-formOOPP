# Evidence OOPP — co se na GitHub nedává
# (lokální data, desktopová aplikace a knihovny)
OOPP_data.json
OOPP_data.json.tmp
# Seznamy zaměstnanců z personalistiky (osobní data) — do veřejného repa nepatří.
SEZNAM_*.json
OOPP.exe
*.dll
OOPP.ico
Pridat-na-plochu.bat

# --- Android / APK ---
# APK se nesestavuje na počítači, ale automaticky na GitHubu
# (.github/workflows/android-apk.yml), proto se build složky necommitují.
# Podpisový klíč android/keystore/oopp.jks se naopak commituje schválně —
# díky stejnému klíči jde nová verze nainstalovat přes starou.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.iml

# --- Testovací kopie stránky ---
# Při vývoji se z index.html generují dočasné kopie s testy (__t-fn.html apod.);
# do repa ani na server nepatří.
__t-*.html
