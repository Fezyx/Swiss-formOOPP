<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 a novější kreslí vlastní úvodní obrazovku s velkou ikonou
     aplikace. Nahradíme ji průhlednou (splash_blank) a podklad dáme modrý,
     takže start vypadá jako jediná modrá obrazovka s logem z aplikace. -->
<resources>
  <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@color/oopp_blue</item>
    <item name="android:colorBackground">@color/oopp_blue</item>
    <item name="android:windowSplashScreenBackground">@color/oopp_blue</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    <item name="android:windowSplashScreenAnimationDuration">0</item>
  </style>
</resources>
